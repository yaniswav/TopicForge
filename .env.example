# TopicForge runtime configuration.
# Copy to `.env` and edit; or export these variables directly.
# An invalid value aborts startup with "topicforge: configuration error: ..."
# (exit code 2) instead of being ignored.

# Runtime mode: mock | live | auto
#   mock - always use deterministic fixtures (default for development & CI)
#   live - use the ROS2 CLI and/or a DDS backend; if neither can start, the
#          server falls back to the mock fixtures with a logged warning
#          (health_check then reports mode=mock next to requested_mode=live)
#   auto - use live if `ros2` is on PATH, otherwise mock (default)
# An explicit TOPICFORGE_DDS_BACKEND (below) is honoured in `live` and `auto`
# even without `ros2`; only `mock` forces fixtures unconditionally.
TOPICFORGE_MODE=auto

# Log level: DEBUG | INFO | WARNING | ERROR
TOPICFORGE_LOG_LEVEL=INFO

# Override the ROS2 executable name (rarely needed).
TOPICFORGE_ROS2_BIN=ros2

# Opt-in anonymous usage telemetry (default: off).
#   on  : on | 1 | true | yes | enabled
#   off : off | 0 | false | no | disabled (or leave unset)
# Any other value is a configuration error and stops the server.
# When on, each tool call emits {tool_name, latency_ms, mode, version,
# session_id, success}. session_id is a random UUID regenerated on every
# server start - never persisted. No topic names, no message bodies, no
# bag paths, no environment data. See the README "Telemetry" section.
TOPICFORGE_TELEMETRY=off

# DDS module backend: one of mock | cyclone | fast | opendds | dust | auto
# (default: mock).
#
#   mock    - deterministic fixtures, no SDK required (default)
#   cyclone - Eclipse CycloneDDS, requires `pip install topicforge[dds-cyclone]`
#             ([dds] is equivalent)
#   fast    - eProsima Fast DDS. The `fastdds` Python binding is NOT on PyPI:
#             build it from eProsima's Fast-DDS-python sources and install it
#             next to TopicForge. There is no `[dds-fast]` extra (removed in
#             0.5.3).
#   opendds - permanent stub, never serves (no extra exists)
#   dust    - permanent stub, never serves (no extra exists)
#   auto    - probe importable bindings: fast > cyclone > mock
#
# `rti`, `opensplice`, `coredx` and `intercom` were accepted until 0.5.2 and
# are now rejected with a configuration error (the Pro tier is retired; see
# docs/pro.md). Cyclone and Fast observe RTI, CoreDX and OpenSplice
# participants through standard RTPS discovery without them.
#
# An explicit value (cyclone, fast, auto) is honoured with or without `ros2`
# on PATH, in every TOPICFORGE_MODE except `mock`. If the binding is missing
# the server logs a warning and falls back to the ROS2 CLI alone, or to mock.
# Cyclone has run against a live bus; Fast has not. See
# docs/DDS_QUICKSTART.md and docs/dds-interop-matrix.md.
TOPICFORGE_DDS_BACKEND=mock

# DDS domain id observed when the DDS module is active (0..232). Joined at
# startup: changing it needs a restart.
TOPICFORGE_DDS_DOMAIN_ID=0

# Size cap for one sampled message, in bytes (1024..67108864, default
# 1048576). A call returns at most 4 times this; larger messages are dropped
# and the result `note` says so.
# TOPICFORGE_MAX_SAMPLE_BYTES=1048576
