[
  {"list_tools": true},
  {"name": "01_health_check", "tool": "health_check"},
  {"name": "02_list_topics", "tool": "list_topics"},
  {"name": "02n_list_nodes", "tool": "list_nodes"},
  {"name": "03_topic_info_{slug}", "tool": "get_topic_info", "for_each": "topics",
   "args": {"topic": "{item}"}},
  {"settle_s": 3},
  {"name": "04_list_participants", "tool": "list_participants"},
  {"name": "05_list_endpoints", "tool": "list_endpoints"},
  {"name": "06_detect_qos_mismatches", "tool": "detect_qos_mismatches"},
  {"name": "03n_node_info_{slug}", "tool": "get_node_info", "for_each": "nodes",
   "args": {"node": "{item}", "timeout_s": 4}, "timeout": 60},
  {"name": "07_sample_scan_full", "tool": "sample_messages", "timeout": 60,
   "args": {"topic": "/scan", "count": 1, "max_array_length": null, "timeout_s": 20}},
  {"name": "08_sample_scan_defaults", "tool": "sample_messages", "timeout": 60,
   "args": {"topic": "/scan", "count": 1}},
  {"name": "08c_sample_scan_rate", "tool": "sample_messages", "timeout": 60,
   "args": {"topic": "/scan", "count": 12, "timeout_s": 20}},
  {"name": "08d_sample_clock_rate", "tool": "sample_messages", "timeout": 60,
   "args": {"topic": "/clock", "count": 50, "timeout_s": 20}},
  {"name": "20_sample_{slug}", "tool": "sample_messages", "for_each": "topics", "timeout": 60,
   "min_publishers": 1,
   "exclude": ["/scan", "/rosout", "/parameter_events", "/tf", "/tf_static",
               "/robot_description_lite", "/robot1/bench_lifecycle/transition_event", "/bond"],
   "args": {"topic": "{item}", "count": 12, "timeout_s": 30}},
  {"name": "21_log_error_node", "tool": "sample_messages", "timeout": 60,
   "args": {"topic": "/rosout", "count": 20, "min_log_level": "error",
            "node": "/bench_robot", "timeout_s": 6}},
  {"name": "22_log_warn", "tool": "sample_messages", "timeout": 60,
   "args": {"topic": "/rosout", "count": 20, "min_log_level": "warn", "timeout_s": 6}},
  {"name": "23_log_blocked_node", "tool": "sample_messages", "timeout": 60,
   "args": {"topic": "/rosout", "count": 5, "node": "/bench_blocked", "timeout_s": 6}},
  {"name": "24_log_lifecycle_node", "tool": "sample_messages", "timeout": 60,
   "args": {"topic": "/rosout", "count": 5, "node": "/robot1/bench_lifecycle",
            "timeout_s": 6}},
  {"name": "17_inspect_tf", "tool": "inspect_tf", "timeout": 90,
   "args": {"window_s": 12, "stale_after_s": 2.0, "source_frame": "camera_optical_frame",
            "target_frame": "base_laser"}},
  {"name": "13_analyze_bag", "tool": "analyze_bag", "needs_bag": true, "timeout": 180,
   "args": {"path": "{BAG}"}},
  {"name": "14_peek_bag_scan", "tool": "peek_bag_samples", "needs_bag": true, "timeout": 120,
   "args": {"path": "{BAG}", "topic": "/scan", "count": 2}},
  {"name": "15_peek_bag_rosout", "tool": "peek_bag_samples", "needs_bag": true, "timeout": 120,
   "requires_bag_topic": "/rosout", "args": {"path": "{BAG}", "topic": "/rosout", "count": 3}},
  {"name": "16_peek_bag_clock", "tool": "peek_bag_samples", "needs_bag": true, "timeout": 120,
   "requires_bag_topic": "/clock", "args": {"path": "{BAG}", "topic": "/clock", "count": 3}},
  {"name": "25_peek_bag_rosout_error", "tool": "peek_bag_samples", "needs_bag": true,
   "timeout": 120, "requires_bag_topic": "/rosout",
   "args": {"path": "{BAG}", "topic": "/rosout", "count": 10,
            "min_log_level": "error"}},
  {"name": "26_peek_bag_clock_range", "tool": "peek_bag_samples", "needs_bag": true,
   "timeout": 120, "requires_bag_topic": "/clock",
   "args": {"path": "{BAG}", "topic": "/clock", "count": 50, "start_s": 2,
            "end_s": 4}},
  {"settle_s": 3}
]
