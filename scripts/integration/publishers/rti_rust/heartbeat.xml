<?xml version='1.0'?>
<!--
  RTI Connector application definition of the rti_rust demo participant.

  This file is a TEMPLATE: src/main.rs embeds it, replaces the token
  __DOMAIN_ID__ with the domain option value and hands the result to
  Connector::new as an XML string (a str:// URL). The file contains no double
  quote character on purpose, so that it can sit inside the quoted str:// URL.
  The type, topic and QoS follow ../../DEMO_CONTRACT.md: type Heartbeat
  { uint32 seq; }, topic DemoHeartbeat, RELIABLE writer, other QoS default.
-->
<dds>
  <types>
    <struct name='Heartbeat' extensibility='extensible'>
      <member name='seq' type='uint32'/>
    </struct>
  </types>

  <domain_library name='DemoDomainLibrary'>
    <domain name='DemoDomain' domain_id='__DOMAIN_ID__'>
      <register_type name='Heartbeat' type_ref='Heartbeat'/>
      <topic name='DemoHeartbeat' register_type_ref='Heartbeat'/>
    </domain>
  </domain_library>

  <domain_participant_library name='DemoParticipantLibrary'>
    <domain_participant name='RtiRustHeartbeat' domain_ref='DemoDomainLibrary::DemoDomain'>
      <publisher name='HeartbeatPublisher'>
        <data_writer name='HeartbeatWriter' topic_ref='DemoHeartbeat'>
          <datawriter_qos>
            <reliability>
              <kind>RELIABLE_RELIABILITY_QOS</kind>
            </reliability>
          </datawriter_qos>
        </data_writer>
      </publisher>
    </domain_participant>
  </domain_participant_library>
</dds>
