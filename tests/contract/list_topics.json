{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true,
    "readOnlyHint": true,
    "title": "List ROS 2 topics"
  },
  "description": "ROS 2 graph only; on a DDS-only setup use `list_endpoints`. List the topics on the ROS 2 graph (or the mock graph) as a `TopicListing`: each has `name`, `message_type`, `publisher_count` and `subscriber_count`; `mode_effective` tells a real graph from fixtures. QoS is not listed: use `get_topic_info`. **Empty `topics`** when the graph has none or live discovery times out. **Raises an MCP error** without a `ros2` CLI. Read-only; no side effects. **Duration**: runs the `ros2` CLI behind the ROS lock (one call at a time); the whole call, lock wait included, ends within 45 s, and if another `ros2` call holds the lock it fails at once with a `busy` error (retry).",
  "inputSchema": {
    "properties": {},
    "type": "object"
  },
  "name": "list_topics",
  "outputSchema": {
    "$defs": {
      "TopicListItem": {
        "additionalProperties": false,
        "properties": {
          "message_type": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "publisher_count": {
            "minimum": 0,
            "type": "integer"
          },
          "subscriber_count": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "name",
          "message_type",
          "publisher_count",
          "subscriber_count"
        ],
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "Envelope returned by `list_topics`.",
    "properties": {
      "mode_effective": {
        "description": "`live` or `mock` (fixtures).",
        "enum": [
          "mock",
          "live"
        ],
        "type": "string"
      },
      "note": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "One sentence of context, or `None`."
      },
      "returned": {
        "minimum": 0,
        "type": "integer"
      },
      "topics": {
        "items": {
          "$ref": "#/$defs/TopicListItem"
        },
        "type": "array"
      },
      "total": {
        "minimum": 0,
        "type": "integer"
      },
      "truncated": {
        "type": "boolean"
      }
    },
    "required": [
      "topics",
      "returned",
      "total",
      "truncated",
      "mode_effective"
    ],
    "title": "TopicListing",
    "type": "object"
  },
  "title": "List ROS 2 topics"
}
